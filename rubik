#!/usr/bin/env python3
# Affiche uniquement la solution du melange fourni

from sys import argv, stderr

from common.moves import parse_moves
from solving.cfop import solve


if len(argv) != 2:
	print('Usage : ./rubik "<melange>"', file=stderr)
	raise SystemExit(1)

try:
	moves = parse_moves(argv[1])
except ValueError as error:
	print(f"Erreur : {error}", file=stderr)
	raise SystemExit(1)

try:
	solution = solve(moves)
except Exception as error:
	print(f"Erreur de resolution : {error}", file=stderr)
	raise SystemExit(2)

print(" ".join(solution))
